# Variáveis de ambiente opcionais que o config.py entende (via os.environ).
# Sem python-dotenv no projeto: este arquivo é só documentação. Para usar
# de verdade, exporte antes de rodar (`export DATABASE_URL=...`) ou defina
# no seu devenv.nix / shell.

# Precisa bater com usuário/senha/host/porta/nome do banco criado por
# database/create_database.sql.
DATABASE_URL=mysql+pymysql://root:SUASENHA@localhost:3306/trilhas_db

SECRET_KEY=troque-esta-chave-em-producao
TOKEN_EXP_MINUTES=1440
FLASK_DEBUG=true
