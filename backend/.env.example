# Variáveis de ambiente que o config.py entende (via os.environ).
# Sem python-dotenv no projeto: este arquivo é documentação. Exporte as
# variáveis no shell, serviço de hospedagem ou ambiente de desenvolvimento.

# Precisa bater com usuário/senha/host/porta/nome do banco criado por
# database/create_database.sql.
DATABASE_URL=mysql+pymysql://root:SUASENHA@localhost:3307/trilhas_db

SECRET_KEY=troque-esta-chave-em-producao
TOKEN_EXP_MINUTES=1440
FLASK_DEBUG=true

# O mapa usa MapLibre GL JS + OpenFreeMap e não requer chave de API.
